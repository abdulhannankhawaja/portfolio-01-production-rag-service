# Create a local .env file. Never commit credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional USD pricing rates used for estimated per-question cost reporting.
# Set both rates from your provider's current pricing to enable cost estimates.
# GEMINI_INPUT_COST_PER_MILLION=
# GEMINI_OUTPUT_COST_PER_MILLION=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_PROVIDER=local
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-multilingual-light-v3.0
EMBEDDING_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2
MAX_UPLOAD_MB=25
MAX_QUESTION_CHARS=2000
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_RETRIEVAL_SCORE=0.84
MAX_REQUESTS_PER_MINUTE=60
# Set a stable random secret in .env to keep JWTs valid across restarts.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
